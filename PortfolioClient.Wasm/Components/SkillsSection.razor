<section class="skills-section" id="skills-section">
    <div class="section-header">
        <h2 class="section-title" style="margin-bottom: 2rem; line-height: 1.4;">Skills & Expertise</h2>
        <p class="section-subtitle">
            Core technologies and tools I leverage to build enterprise-grade applications.
        </p>
    </div>

    <div class="skills-container">
        <!-- Core Technologies -->
        <div class="skill-category-new">
            <div class="category-header-new">
                <span class="category-icon-new">⚡</span>
                <h3 class="category-title-new">Core Technologies</h3>
            </div>
            <div class="skills-badge-grid">
                <span class="skill-badge-new skill-highlight">C# & .NET</span>
                <span class="skill-badge-new skill-highlight">ASP.NET Core</span>
                <span class="skill-badge-new">Web API (RESTful)</span>
                <span class="skill-badge-new">Entity Framework</span>
                <span class="skill-badge-new skill-highlight">Microsoft SQL Server</span>
                <span class="skill-badge-new">SignalR</span>
            </div>
        </div>

        <!-- Frontend -->
        <div class="skill-category-new">
            <div class="category-header-new">
                <span class="category-icon-new">🎨</span>
                <h3 class="category-title-new">Frontend Development</h3>
            </div>
            <div class="skills-badge-grid">
                <span class="skill-badge-new skill-highlight">Blazor</span>
                <span class="skill-badge-new skill-highlight">Angular</span>
                <span class="skill-badge-new">TypeScript</span>
                <span class="skill-badge-new">JavaScript</span>
                <span class="skill-badge-new">HTML & CSS</span>
                <span class="skill-badge-new">SASS</span>
            </div>
        </div>

        <!-- Cloud & DevOps -->
        <div class="skill-category-new">
            <div class="category-header-new">
                <span class="category-icon-new">☁️</span>
                <h3 class="category-title-new">Cloud & DevOps</h3>
            </div>
            <div class="skills-badge-grid">
                <span class="skill-badge-new skill-highlight">Azure</span>
                <span class="skill-badge-new">Azure DevOps</span>
                <span class="skill-badge-new">Azure Static Web Apps</span>
                <span class="skill-badge-new">GitHub Actions</span>
                <span class="skill-badge-new">GIT & GitHub</span>
                <span class="skill-badge-new">Jenkins</span>
                <span class="skill-badge-new">CI/CD</span>
                <span class="skill-badge-new">AWS</span>
            </div>
        </div>

        <!-- Database -->
        <div class="skill-category-new">
            <div class="category-header-new">
                <span class="category-icon-new">💾</span>
                <h3 class="category-title-new">Database & Data</h3>
            </div>
            <div class="skills-badge-grid">
                <span class="skill-badge-new skill-highlight">T-SQL & SSMS</span>
                <span class="skill-badge-new">Azure SQL</span>
                <span class="skill-badge-new">PostgreSQL</span>
            </div>
        </div>

        <!-- Security & Authentication -->
        <div class="skill-category-new">
            <div class="category-header-new">
                <span class="category-icon-new">🔒</span>
                <h3 class="category-title-new">Security & Authentication</h3>
            </div>
            <div class="skills-badge-grid">
                <span class="skill-badge-new">JWT</span>
                <span class="skill-badge-new">OAuth 2.0</span>
                <span class="skill-badge-new">Microsoft Entra ID</span>
                <span class="skill-badge-new">Stripe Payment</span>
            </div>
        </div>

        <!-- UI Libraries & Tools -->
        <div class="skill-category-new">
            <div class="category-header-new">
                <span class="category-icon-new">🛠️</span>
                <h3 class="category-title-new">Libraries & Frameworks</h3>
            </div>
            <div class="skills-badge-grid">
                <span class="skill-badge-new">Telerik</span>
                <span class="skill-badge-new">Bootstrap</span>
                <span class="skill-badge-new">Highcharts</span>
                <span class="skill-badge-new">Angular Material</span>
                <span class="skill-badge-new">Swagger</span>
                <span class="skill-badge-new">Node.js</span>
            </div>
        </div>
    </div>

    <!-- Methodologies & Practices -->
    <div class="practices-section">
        <h3 class="practices-title">Methodologies & Best Practices</h3>
        <div class="practices-grid">
            <span class="practice-badge">Agile/Scrum</span>
            <span class="practice-badge">RESTful API Design</span>
            <span class="practice-badge">Repository Pattern</span>
            <span class="practice-badge">Clean Architecture</span>
            <span class="practice-badge">Code Reviews</span>
            <span class="practice-badge">Version Control</span>
            <span class="practice-badge">Test-Driven Development</span>
            <span class="practice-badge">Cross-functional Collaboration</span>
            <span class="practice-badge">UI/UX Design Principles</span>
            <span class="practice-badge">Accessibility Standards</span>
            <span class="practice-badge">Security Best Practices</span>
            <span class="practice-badge">Performance Optimization</span>
        </div>
    </div>
</section>

